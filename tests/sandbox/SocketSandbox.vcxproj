  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <Target Name="CopyAsanRuntime" AfterTargets="Build">
    <!--
      ASan links against clang_rt.asan_dynamic and the loader needs the DLL
      beside the binary; without it the exe fails to start at all rather
      than reporting anything useful.
    -->
    <ItemGroup>
      <AsanRuntime Include="$(VCToolsInstallDir)bin\Hostx64\x64\clang_rt.asan_dynamic-x86_64.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AsanRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(AsanRuntime.FullPath)')" />
  </Target>
