# BlorgFS local deploy/debug settings.
#
# Copy to blorgfs.env (same directory) and fill in. That filename is
# gitignored; this template is not, and must never gain real values.
#
# Every setting here is a credential for a disposable debug VM, not a real
# secret -- but the KDNET key in particular lets anyone on the network
# attach a kernel debugger to that guest, so treat the filled-in file the
# way you would any other key material.
#
# Loaded by deploy/Get-BlorgEnv.ps1. Explicit script arguments always win,
# so nothing here is binding.

# Full path to the VM's .vmx.
VmxPath=C:\Users\you\Documents\Virtual Machines\Win11\Win11.vmx

# Guest account with admin rights. VMware Tools must be running in the guest.
GuestUser=dev
GuestPassword=changeme

# The .vmx's own config-encryption password, if the VM is encrypted. This is
# separate from GuestPassword and is passed to vmrun as -vp. Leave empty for
# an unencrypted VM.
VmPassword=

# Snapshot to revert to before each deploy. A known-good, driver-free state:
# a buggy load can bugcheck the guest, and a half-installed package is worse
# to debug than a clean one.
SnapshotName=clean

# Snapshot for performance work: same guest, but with Driver Verifier already
# cleared. Verifier state lives IN the snapshot, so a plain deploy reverts to
# SnapshotName and brings verifier back with it -- which is how an entire
# throughput study once got measured against a verified driver.
#
# Deploy-ToVM.ps1 -ForBenchmark clears verifier itself and reboots, so this is
# an optimisation, not a requirement: pointing -SnapshotName at a
# verifier-free snapshot skips that extra reboot per run. Create it by hand
# (vmrun cannot snapshot an encrypted VM while it is running): boot the guest,
# run `verifier.exe /reset`, reboot, power off, then take the snapshot.
BenchSnapshotName=

# Backend the driver should be pointed at. Overrides the INF's seeded
# Parameters\RemoteHost, which matches BLORGFS_DEFAULT_REMOTE_HOST in
# Driver.c.
RemoteHost=10.0.50.17
RemotePort=8080

# A file on the mounted volume large enough for the Perf tier to reach
# steady state -- comfortably larger than Cc's read-ahead window.
PerfFile=B:\movies\big.mkv
PerfDrive=B

# KDNET key for attaching WinDbg/kd to the guest. Pair with the host/port
# the guest's bcdedit dbgsettings reports.
KdnetKey=
KdnetPort=50000
