#!/usr/bin/env bash
#
# blorg -- build, deploy and test BlorgFS + server-rs from a Linux shell.
#
# The one entrypoint for a coding agent (Claude Code, Codex, ...) or a person
# working from a Linux cloud session, where MSVC and the WDK cannot run.
# Every command says what it needs; `blorg doctor` says which of those this
# session has. See "Remote agents" in AGENTS.md.
#
# Three places work happens, cheapest first:
#
#   here      (Linux, no Windows anywhere)
#     setup                 fetch/build what the local checks need (cached)
#     check                 the Linux tier: driver compile check against the
#                           real WDK headers, schema pins, server-rs tests,
#                           clippy, and a Windows-target clippy of server-rs
#     driver-check [file..] just the driver compile check
#     server-exe [--out D]  build server-rs.exe for Windows (MSVC via
#                           cargo-xwin when Microsoft's CDN is reachable,
#                           else mingw -- fine for iteration, not shipped)
#
#   ci        (GitHub Actions; needs a GitHub token, see `doctor`)
#     ci build [--ref R]    dispatch "Build BlorgFS" and wait; prints failing
#                           job logs. Its package artifact feeds `ci guest`
#     ci guest [--package-run ID] [--no-verifier]
#                           dispatch the Windows guest runtime tests, wait,
#                           download guest-results/, print the verdict
#     ci remote [--ref R] [--action build|build-test] [--tier T] [--runner hosted|kvm]
#                           dispatch agent-remote.yml: build (and test) on
#                           a Windows runner, or on the KVM host's build VM
#     ci status [--ref R]   latest runs of every workflow for a ref
#     ci results ID         download a run's artifacts and print verdicts
#
#   win       (a KVM host: this machine if it has /dev/kvm, else
#              BLORG_KVM_SSH=user@host; the host is set up once with
#              ci/agent/host/setup-kvm-host.sh)
#     win up [--fresh] | down | status | ssh [cmd]
#     win sync              copy this working tree into the build VM
#     win build [--tier T] [--config C]
#                           sync, then Invoke-BlorgChecks + package in the
#                           build VM; the package lands in out/package
#     win test [--package D] [--no-verifier] [--keep]
#                           run-guest-tests.sh on a fresh test guest with
#                           that package (default: the last win build's)
#
#   doctor                  what this session can and cannot do, and why
#
# Exit codes: 0 pass, 1 checks/tests failed, 2 the tool or environment broke.

set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GH_REPO="${BLORG_GH_REPO:-Chuccle/BlorgFS}"
CACHE="${BLORG_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/blorg}"
OUT="${BLORG_OUT:-$REPO/out}"
mkdir -p "$CACHE"

die()  { echo "blorg: $*" >&2; exit 2; }
note() { echo "blorg: $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
hdr()  { echo; echo "==> $*"; }

# ---------------------------------------------------------------- locations

# server-rs: the pinned submodule once BlorgFS carries it, else a sibling
# checkout (cloud sessions often clone both repos side by side).
server_dir() {
    local d
    for d in "${BLORG_SERVER_RS:-}" "$REPO/third_party/server-rs" "$REPO/../server-rs"; do
        [[ -n "$d" && -f "$d/Cargo.toml" ]] && { (cd "$d" && pwd); return 0; }
    done
    return 1
}

# Version of a package in src/packages.config.
pkg_version() {
    sed -n "s/.*id=\"$1\" version=\"\([^\"]*\)\".*/\1/p" "$REPO/src/packages.config" | head -1
}

# NuGet's CDN cuts long HTTP/2 transfers through some egress proxies;
# HTTP/1.1 survives them, so force it.
nuget_fetch() {
    local id="$1" ver="$2" dest="$CACHE/nuget/$1.$2"
    [[ -f "$dest/.ok" ]] && { echo "$dest"; return 0; }
    local lid="${id,,}"
    mkdir -p "$CACHE/nuget"
    note "fetching $id $ver from nuget.org"
    curl -fsSL --http1.1 --retry 4 --retry-delay 3 -o "$dest.nupkg" \
        "https://api.nuget.org/v3-flatcontainer/$lid/$ver/$lid.$ver.nupkg" || return 1
    rm -rf "$dest"; mkdir -p "$dest"
    # Headers only: the libs and tools are Windows binaries we cannot use.
    unzip -q -o "$dest.nupkg" 'c/Include/*' -d "$dest" || return 1
    rm -f "$dest.nupkg"
    touch "$dest/.ok"
    echo "$dest"
}

flatcc_bin() { echo "$REPO/third_party/flatcc/bin/flatcc"; }
flatc_bin()  { echo "$CACHE/flatc/flatc"; }

# ---------------------------------------------------------------- setup

setup_flatcc() {
    [[ -x "$(flatcc_bin)" ]] && return 0
    have cmake || { note "cmake missing; cannot build flatcc"; return 1; }
    git -C "$REPO" submodule update --init third_party/flatcc >/dev/null || return 1
    note "building flatcc (driver-side schema compiler)"
    cmake -S "$REPO/third_party/flatcc" -B "$CACHE/flatcc-build" -DCMAKE_BUILD_TYPE=Release \
        -DFLATCC_TEST=OFF ${BLORG_CMAKE_GENERATOR:+-G "$BLORG_CMAKE_GENERATOR"} >/dev/null &&
    cmake --build "$CACHE/flatcc-build" -j"$(nproc)" >/dev/null 2>&1
}

# The same codegen build.yml runs, so the driver sources see the same headers.
gen_driver_headers() {
    git -C "$REPO" submodule update --init third_party/schemas third_party/picohttpparser >/dev/null || return 1
    setup_flatcc || return 1
    mkdir -p "$REPO/generated"
    "$(flatcc_bin)" -rv --common_reader -o "$REPO/generated" "$REPO/third_party/schemas/metadata_flatbuffer.fbs"
}

setup_wdk_headers() {
    local wdk sdk
    have unzip || { note "unzip missing"; return 1; }
    wdk="$(nuget_fetch Microsoft.Windows.WDK.x64 "$(pkg_version Microsoft.Windows.WDK.x64)")" || return 1
    sdk="$(nuget_fetch Microsoft.Windows.SDK.CPP "$(pkg_version Microsoft.Windows.SDK.CPP)")" || return 1
    printf '%s\n%s\n' "$wdk" "$sdk"
}

# flatc from server-rs's own pinned flatbuffers, as its CI builds it: the
# generated Rust must match the flatbuffers crate version.
setup_flatc() {
    local srv="$1" rev
    rev="$(git -C "$srv" submodule status buildtools/flatbuffers 2>/dev/null | awk '{print $1}' | tr -d '+-')"
    if [[ -x "$(flatc_bin)" && -f "$CACHE/flatc/.rev" && "$(cat "$CACHE/flatc/.rev")" == "$rev" ]]; then return 0; fi
    git -C "$srv" submodule update --init --recursive >/dev/null || return 1
    note "building flatc (server-side schema compiler)"
    cmake -S "$srv/buildtools/flatbuffers" -B "$CACHE/flatc-build" -DCMAKE_BUILD_TYPE=Release \
        -DFLATBUFFERS_BUILD_TESTS=OFF -DFLATBUFFERS_BUILD_FLATLIB=OFF -DFLATBUFFERS_BUILD_FLATHASH=OFF >/dev/null &&
    cmake --build "$CACHE/flatc-build" --target flatc -j"$(nproc)" >/dev/null 2>&1 || return 1
    mkdir -p "$CACHE/flatc"
    cp "$CACHE/flatc-build/flatc" "$CACHE/flatc/flatc"
    echo "$rev" > "$CACHE/flatc/.rev"
}

cmd_setup() {
    local rc=0 srv
    hdr "driver: flatcc + generated headers";   gen_driver_headers >/dev/null || { note "FAILED"; rc=2; }
    hdr "driver: WDK + SDK headers (NuGet)";    setup_wdk_headers  >/dev/null || { note "FAILED"; rc=2; }
    if srv="$(server_dir)"; then
        hdr "server-rs ($srv): flatc + Rust targets"
        setup_flatc "$srv" || { note "flatc FAILED"; rc=2; }
        if have rustup; then
            rustup target add x86_64-pc-windows-msvc x86_64-pc-windows-gnu >/dev/null 2>&1 || note "rustup target add failed"
        fi
        if ! have x86_64-w64-mingw32-gcc && [[ $EUID -eq 0 ]] && have apt-get; then
            note "installing mingw-w64 (for server-exe without the MSVC CRT)"
            apt-get install -y -q gcc-mingw-w64-x86-64 >/dev/null 2>&1 ||
                { apt-get update -q >/dev/null 2>&1 && apt-get install -y -q gcc-mingw-w64-x86-64 >/dev/null 2>&1; } ||
                note "mingw-w64 install failed; server-exe will need cargo-xwin"
        fi
    else
        note "no server-rs checkout found (third_party/server-rs, ../server-rs or \$BLORG_SERVER_RS); skipping its setup"
    fi
    return $rc
}

# ---------------------------------------------------------------- driver check

# Compiles every driver translation unit with clang against the WDK's own
# kernel headers: catches what a compile catches (typos, undeclared or
# misused APIs, type errors, header breakage) in seconds, with no Windows.
# It is NOT the MSVC build: no PREfast, no link, no signing, and clang's
# diagnostics differ from cl's -- Invoke-BlorgChecks on Windows stays the
# gate. Defines and include paths are read from BlorgFS.vcxproj so the two
# cannot drift apart.
cmd_driver_check() {
    have clang || die "clang missing (apt-get install clang)"
    local verbose=0 files=()
    while (( $# )); do case "$1" in -v|--verbose) verbose=1; shift ;; *) files+=("$1"); shift ;; esac; done

    gen_driver_headers >/dev/null || die "could not generate the flatcc headers"
    local paths wdk sdk
    paths="$(setup_wdk_headers)" || die "could not fetch WDK/SDK headers"
    wdk="$(sed -n 1p <<<"$paths")"; sdk="$(sed -n 2p <<<"$paths")"
    local winc sinc
    winc="$(ls -d "$wdk"/c/Include/10.* | sort -V | tail -1)"
    sinc="$(ls -d "$sdk"/c/Include/10.* | sort -V | tail -1)"

    local proj="$REPO/src/BlorgFS.vcxproj" defs incs
    defs="$(grep -o '<PreprocessorDefinitions>[^<]*' "$proj" | head -1 | sed 's/<PreprocessorDefinitions>//')"
    incs="$(grep -o '<AdditionalIncludeDirectories>[^<]*' "$proj" | head -1 | sed 's/<AdditionalIncludeDirectories>//')"
    local -a flags=(
        -fsyntax-only --target=x86_64-pc-windows-msvc
        -fms-extensions -fms-compatibility -fms-compatibility-version=19.40
        -nostdinc -isystem "$(clang -print-resource-dir)/include"
        -isystem "$winc/km/crt" -isystem "$winc/km" -isystem "$winc/shared" -isystem "$sinc/shared"
        -D_AMD64_ -DAMD64 -D_WIN64 -D_KERNEL_MODE
        # What MSVC accepts as a warning (C4028-style pointer mismatches)
        # clang makes an error; keep it visible but not fatal.
        -Wno-error=incompatible-function-pointer-types
        # Noise from WDK idioms that MSVC never warns about.
        -Wno-microsoft-anon-tag -Wno-multichar -Wno-microsoft-static-assert
    )
    local d i
    IFS=';' read -ra parts <<<"$defs"
    for d in "${parts[@]}"; do [[ -n "$d" && "$d" != %* ]] && flags+=("-D$d"); done
    IFS=';' read -ra parts <<<"$incs"
    for i in "${parts[@]}"; do
        [[ -z "$i" || "$i" == %* ]] && continue
        i="${i//\$(ProjectDir)/$REPO/src/}"; i="${i//\\//}"
        flags+=("-I$i")
    done

    if (( ${#files[@]} == 0 )); then
        mapfile -t files < <(grep -o 'ClCompile Include="[^"]*"' "$proj" | sed 's/.*="//;s/"$//;s#\\#/#g;s#^#src/#')
    fi
    local f out fail=0 nerr nwarn
    for f in "${files[@]}"; do
        out="$(cd "$REPO" && clang "${flags[@]}" "$f" 2>&1)"
        nerr="$(grep -c 'error:' <<<"$out")"; nwarn="$(grep -c 'warning:' <<<"$out")"
        if (( nerr )); then
            fail=1; echo "FAIL $f ($nerr errors)"; grep -A3 'error:' <<<"$out" | head -40
        else
            if (( nwarn )); then echo "ok   $f ($nwarn warnings)"; else echo "ok   $f"; fi
            (( verbose )) && [[ -n "$out" ]] && echo "$out"
        fi
    done
    return $fail
}

# ---------------------------------------------------------------- pins

# The schema pin check from tools/Test-BlorgPackagePins.ps1, without pwsh.
cmd_pins() {
    local srv_pin drv_schemas srv_schemas srv
    drv_schemas="$(git -C "$REPO" ls-files -s -- third_party/schemas | awk '{print $2}')"
    if srv_pin="$(git -C "$REPO" ls-files -s -- third_party/server-rs | awk '$1=="160000"{print $2}')" && [[ -n "$srv_pin" ]]; then
        git -C "$REPO" submodule update --init third_party/server-rs >/dev/null 2>&1
        srv_schemas="$(git -C "$REPO/third_party/server-rs" ls-tree "$srv_pin" -- schemas | awk '{print $3}')"
        echo "driver schemas $drv_schemas; pinned server-rs ${srv_pin:0:7} schemas $srv_schemas"
    elif srv="$(server_dir)"; then
        srv_schemas="$(git -C "$srv" ls-files -s -- schemas | awk '{print $2}')"
        echo "driver schemas $drv_schemas; server-rs checkout at $srv (not pinned here) schemas $srv_schemas"
    else
        echo "no server-rs to compare against"; return 0
    fi
    [[ "$drv_schemas" == "$srv_schemas" ]] || { echo "FAIL: driver and server compile different schemas"; return 1; }
    echo "ok   schemas match"
}

# ---------------------------------------------------------------- server

server_env() {
    local srv="$1"
    setup_flatc "$srv" || die "could not build flatc"
    export PATH="$CACHE/flatc:$PATH"
    # A panicking test's full backtrace buries the assertion in a terminal
    # transcript; ask for it with BLORG_RUST_BACKTRACE=1.
    export RUST_BACKTRACE="${BLORG_RUST_BACKTRACE:-0}"
}

cmd_server_test() {
    local srv rc=0
    srv="$(server_dir)" || die "no server-rs checkout"
    server_env "$srv"
    hdr "server-rs: cargo test";  (cd "$srv" && cargo test --locked -q) || rc=1
    hdr "server-rs: clippy";      (cd "$srv" && cargo clippy --locked -q --all-targets -- -D warnings) || rc=1
    # Type-checks the cfg(windows) code paths without any Windows SDK.
    # Library and binary only: the benches pull in criterion -> alloca, a C
    # build that needs MSVC's lib.exe.
    hdr "server-rs: clippy for x86_64-pc-windows-msvc"
    (cd "$srv" && cargo clippy --locked -q --release --target x86_64-pc-windows-msvc --lib --bins -- -D warnings) || rc=1
    return $rc
}

cmd_server_exe() {
    local out="$OUT/server" srv
    [[ "${1:-}" == "--out" ]] && out="$2"
    srv="$(server_dir)" || die "no server-rs checkout"
    server_env "$srv"
    mkdir -p "$out"
    if have cargo-xwin && (cd "$srv" && cargo xwin build --locked --release --target x86_64-pc-windows-msvc); then
        cp "$srv/target/x86_64-pc-windows-msvc/release/server-rs.exe" "$out/"
        note "MSVC build (as shipped): $out/server-rs.exe"
        return 0
    fi
    note "cargo-xwin unavailable or Microsoft's CDN unreachable; building with mingw-w64 instead"
    (cd "$srv" && cargo build --locked --release --target x86_64-pc-windows-gnu) || return 1
    cp "$srv/target/x86_64-pc-windows-gnu/release/server-rs.exe" "$out/"
    note "mingw build (iteration only; the package ships the MSVC one): $out/server-rs.exe"
}

cmd_check() {
    local rc=0
    hdr "schema pins";             cmd_pins || rc=1
    hdr "driver compile check";    cmd_driver_check || rc=1
    if server_dir >/dev/null; then cmd_server_test || rc=1; fi
    echo
    (( rc == 0 )) && echo "Linux tier: PASS" || echo "Linux tier: FAIL"
    echo "Not covered here: MSVC/PREfast build, usermode sandbox suites, driver load. Use 'blorg ci ...' or 'blorg win ...'."
    return $rc
}

# ---------------------------------------------------------------- ci

gh_ok() {
    have gh || return 1
    # An agent environment can carry a token just for this, separately from
    # whatever its git credential is.
    [[ -n "${BLORG_GH_TOKEN:-}" ]] && export GH_TOKEN="$BLORG_GH_TOKEN"
    # Dispatching needs write access; a public repo answers reads without any.
    [[ "$(gh api "repos/$GH_REPO" --jq '.permissions.push' 2>/dev/null)" == "true" ]]
}

need_gh() {
    gh_ok && return 0
    cat >&2 <<EOF
blorg: the GitHub API is not usable from this shell (gh missing or no valid token).
  Either give the session a token: a fine-grained PAT on $GH_REPO with
  Actions: read/write and Contents: read, as BLORG_GH_TOKEN (or GH_TOKEN),
  or drive CI without one:
    - push the branch: "Build BlorgFS" runs on it, and "Guest runtime tests"
      runs on every successful build -- both report back on the PR;
    - Claude Code: the GitHub MCP tools do what this command does
      (actions_run_trigger, actions_list, get_job_logs).
EOF
    exit 2
}

cur_ref() { git -C "$REPO" rev-parse --abbrev-ref HEAD; }

# Dispatch a workflow and print the id of the run it created.
dispatch() {
    local wf="$1" ref="$2"; shift 2
    local since id
    since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gh workflow run "$wf" -R "$GH_REPO" --ref "$ref" "$@" >&2 || return 1
    for _ in $(seq 1 30); do
        sleep 4
        id="$(gh run list -R "$GH_REPO" -w "$wf" -b "$ref" -e workflow_dispatch -L 5 \
              --json databaseId,createdAt --jq "[.[] | select(.createdAt >= \"$since\")][0].databaseId // empty")"
        [[ -n "$id" ]] && { echo "$id"; return 0; }
    done
    note "dispatched $wf but could not find its run"; return 1
}

# Wait for a run; on failure print the tail of each failed job's log. A run
# still queued after BLORG_QUEUE_TIMEOUT seconds (default 600) is waiting for
# a runner that is not there -- usually the self-hosted KVM host being off --
# so it is cancelled rather than waited on for GitHub's 24 hours.
watch_run() {
    local id="$1" status concl start=$SECONDS
    note "https://github.com/$GH_REPO/actions/runs/$id"
    while :; do
        status="$(gh run view "$id" -R "$GH_REPO" --json status --jq .status 2>/dev/null)"
        [[ "$status" == "completed" ]] && break
        if [[ "$status" == "queued" ]] && (( SECONDS - start > ${BLORG_QUEUE_TIMEOUT:-600} )); then
            gh run cancel "$id" -R "$GH_REPO" >/dev/null 2>&1 || true
            note "run $id never left the queue; cancelled. Is a runner for it online? (runner=kvm needs the blorg-kvm host up)"
            return 2
        fi
        sleep 20
    done
    concl="$(gh run view "$id" -R "$GH_REPO" --json conclusion --jq .conclusion)"
    echo "run $id: ${concl:-unknown}"
    if [[ "$concl" != "success" ]]; then
        gh run view "$id" -R "$GH_REPO" --log-failed 2>/dev/null | tail -n "${BLORG_LOG_LINES:-150}"
        return 1
    fi
}

print_verdicts() {
    local dir="$1" v
    while IFS= read -r v; do echo "--- $v"; cat "$v"; done < <(find "$dir" -name verdict.txt 2>/dev/null)
}

cmd_ci() {
    local sub="${1:-}"; shift || true
    local ref; ref="$(cur_ref)"
    case "$sub" in
        build)
            need_gh
            [[ "${1:-}" == "--ref" ]] && ref="$2"
            local id; id="$(dispatch build.yml "$ref")" || exit 2
            echo "build_run=$id"
            watch_run "$id"
            ;;
        guest)
            need_gh
            local args=() a
            while (( $# )); do
                case "$1" in
                    --package-run) args+=(-f "package_run_id=$2"); shift 2 ;;
                    --no-verifier) args+=(-f verifier=false); shift ;;
                    --ref)         ref="$2"; shift 2 ;;
                    *) die "unknown ci guest argument '$1'" ;;
                esac
            done
            local id; id="$(dispatch guest-runtime.yml "$ref" "${args[@]}")" || exit 2
            watch_run "$id"; a=$?
            cmd_ci results "$id"
            return $a
            ;;
        remote)
            need_gh
            local action=build-test tier=Fast runner=hosted
            while (( $# )); do
                case "$1" in
                    --ref)    ref="$2"; shift 2 ;;
                    --action) action="$2"; shift 2 ;;
                    --tier)   tier="$2"; shift 2 ;;
                    --runner) runner="$2"; shift 2 ;;
                    *) die "unknown ci remote argument '$1'" ;;
                esac
            done
            local id rc
            id="$(dispatch agent-remote.yml "$ref" -f "action=$action" -f "tier=$tier" -f "runner=$runner")" || exit 2
            echo "remote_run=$id"
            watch_run "$id"; rc=$?
            cmd_ci results "$id"
            # The KVM host runs the guest tests itself; a hosted build hands
            # its package to the guest workflow.
            if (( rc == 0 )) && [[ "$runner" == "hosted" && "$action" == "build-test" ]]; then
                hdr "guest runtime tests on run $id's package"
                cmd_ci guest --ref "$ref" --package-run "$id"; rc=$?
            fi
            return $rc
            ;;
        status)
            need_gh
            [[ "${1:-}" == "--ref" ]] && ref="$2"
            gh run list -R "$GH_REPO" -b "$ref" -L 15 \
                --json databaseId,workflowName,status,conclusion,headSha,createdAt \
                --jq '.[] | "\(.databaseId)  \(.workflowName)  \(.status)/\(.conclusion // "-")  \(.headSha[0:7])  \(.createdAt)"'
            ;;
        results)
            need_gh
            local id="${1:?usage: blorg ci results RUN_ID}" dest="$OUT/runs/${1}"
            rm -rf "$dest"; mkdir -p "$dest"
            gh run download "$id" -R "$GH_REPO" -D "$dest" >/dev/null 2>&1 || note "run $id has no downloadable artifacts (yet)"
            echo "artifacts: $dest"
            ls "$dest" 2>/dev/null | sed 's/^/  /'
            print_verdicts "$dest"
            ;;
        *) die "usage: blorg ci build|guest|remote|status|results" ;;
    esac
}

# ---------------------------------------------------------------- win

# The build VM is a second guest on the KVM host, from the build layer
# (golden image + VS Build Tools), on its own port and run directory so it
# can sit next to the test guest. Unlike the test guest it is persistent:
# its disk keeps obj/, packages/ and cargo's target/ between builds, which
# is what makes an incremental build quick.
win_env() {
    export GUEST_HOME="${GUEST_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/blorgfs-guest}"
    export GUEST_GOLDEN="${BLORG_BUILD_IMAGE:-$GUEST_HOME/image/build.qcow2}"
    export GUEST_RUN_DIR="$GUEST_HOME/build-run"
    export GUEST_SSH_PORT="${BLORG_BUILD_SSH_PORT:-2223}"
    export GUEST_MEM_MB="${BLORG_BUILD_MEM_MB:-${GUEST_MEM_MB:-8192}}"
}
guestctl() { "$REPO/ci/guest/host/guestctl" "$@"; }
build_vm() { ( win_env; guestctl "$@" ); }

# Not on a KVM host: run this same command there, over SSH, on a copy of
# this working tree.
win_remote() {
    local host="${BLORG_KVM_SSH:-}"
    [[ -n "$host" ]] || die "no /dev/kvm here and BLORG_KVM_SSH is unset.
  Point BLORG_KVM_SSH at a KVM host prepared with ci/agent/host/setup-kvm-host.sh,
  or use 'blorg ci remote --runner kvm' (needs only GitHub) / 'blorg ci remote' (a hosted Windows runner)."
    local rdir="${BLORG_KVM_DIR:-blorg-agent/BlorgFS}"
    note "syncing working tree to $host:$rdir"
    ssh "$host" "mkdir -p '$rdir'" || die "cannot ssh to $host (outbound SSH may be blocked by this environment's network policy)"
    tree_files |
        rsync -a --from0 --files-from=- --delete-missing-args "$REPO/" "$host:$rdir/" || die "rsync failed"
    ssh -t "$host" "cd '$rdir' && BLORG_KVM_SSH= tools/agent/blorg win $*"
    local rc=$?
    mkdir -p "$OUT"
    rsync -a "$host:$rdir/out/" "$OUT/" 2>/dev/null || true
    return $rc
}

# The working tree as a NUL-separated list: tracked files (submodules
# included), untracked-but-not-ignored ones so an agent's new files go along
# too, and the git metadata -- the package script reads commits and the
# schema pins from git, so the copy has to be a repository, not a snapshot.
# (git refuses --others with --recurse-submodules, hence separate calls.)
tree_files() {
    (
        cd "$REPO" || exit 1
        git ls-files -z --recurse-submodules
        git ls-files -z --others --exclude-standard
        find .git -type f -not -name '*.lock' -print0
        # shellcheck disable=SC2016 # expanded by git, per submodule
        git submodule foreach --quiet --recursive 'printf "%s/.git\0" "$displaypath"'
    )
}

on_kvm_host() { [[ -r /dev/kvm && -w /dev/kvm && -z "${BLORG_KVM_SSH:-}" ]]; }

win_sync() {
    [[ -x "$REPO/ci/guest/host/guestctl" ]] || die "ci/guest/ (the test-guest rig) is not in this checkout"
    local tarball="$CACHE/src.tar.gz"
    note "packing working tree (tracked + untracked, not ignored, with submodules)"
    tree_files | (cd "$REPO" && tar --null -T - --ignore-failed-read -czf "$tarball") ||
        die "could not pack the tree"
    build_vm push "$tarball" C:/blorg-agent/src.tar.gz || die "could not copy into the build VM"
    build_vm ps "$REPO/ci/agent/build-vm/Sync-Source.ps1" -Archive C:/blorg-agent/src.tar.gz -Dest C:/src/BlorgFS ||
        die "could not unpack in the build VM"
}

cmd_win() {
    local sub="${1:-}"
    if ! on_kvm_host; then win_remote "$@"; return $?; fi
    shift || true
    case "$sub" in
        up)     build_vm up "$@" ;;
        down)   build_vm down --graceful ;;
        status) build_vm status ;;
        ssh)    build_vm ssh "$@" ;;
        sync)   build_vm up >/dev/null && win_sync ;;
        build)
            local tier=Fast config=Release
            while (( $# )); do
                case "$1" in
                    --tier)   tier="$2"; shift 2 ;;
                    --config) config="$2"; shift 2 ;;
                    *) die "unknown win build argument '$1'" ;;
                esac
            done
            build_vm up || exit 2
            win_sync
            build_vm ps "$REPO/ci/agent/build-vm/Invoke-GuestBuild.ps1" -Source C:/src/BlorgFS \
                -Tier "$tier" -Configuration "$config" -OutDir C:/blorg-agent/out
            local rc=$?
            rm -rf "$OUT/win"; mkdir -p "$OUT"
            build_vm pull C:/blorg-agent/out "$OUT/win" || note "could not copy results out of the build VM"
            if [[ -f "$OUT/win/package/manifest.json" ]]; then
                rm -rf "$OUT/package"; cp -r "$OUT/win/package" "$OUT/package"
                note "package: $OUT/package"
            fi
            [[ -f "$OUT/win/build-summary.txt" ]] && cat "$OUT/win/build-summary.txt"
            return $rc
            ;;
        test)
            local pkg="$OUT/package" args=()
            while (( $# )); do
                case "$1" in
                    --package) pkg="$2"; shift 2 ;;
                    *) args+=("$1"); shift ;;
                esac
            done
            [[ -f "$pkg/manifest.json" ]] || die "no package at $pkg (run 'blorg win build' first, or pass --package)"
            local suites=()
            [[ -d "$REPO/tests/guest-suites" ]] && suites=(--suites "$REPO/tests/guest-suites")
            "$REPO/ci/guest/run-guest-tests.sh" --package "$pkg" --out "$OUT/guest-results" "${suites[@]}" "${args[@]}"
            ;;
        *) die "usage: blorg win up|down|status|ssh|sync|build|test" ;;
    esac
}

# ---------------------------------------------------------------- doctor

cmd_doctor() {
    yes_no() { if "$@" >/dev/null 2>&1; then echo yes; else echo no; fi; }
    local srv; srv="$(server_dir 2>/dev/null || echo none)"
    echo "repo                $REPO"
    echo "server-rs           $srv"
    echo "clang               $(yes_no have clang)"
    echo "cmake               $(yes_no have cmake)"
    echo "cargo               $(yes_no have cargo)"
    echo "cargo-xwin          $(yes_no have cargo-xwin)"
    echo "mingw-w64           $(yes_no have x86_64-w64-mingw32-gcc)"
    echo "nuget.org           $(yes_no curl -fsS --http1.1 -m 10 -o /dev/null https://api.nuget.org/v3/index.json)"
    echo "MS CDN (xwin)       $(yes_no curl -fsS -m 10 -o /dev/null -I https://aka.ms/vs/17/release/channel)"
    echo "GitHub API          $(yes_no gh_ok)"
    echo "/dev/kvm            $(yes_no test -w /dev/kvm)"
    echo "BLORG_KVM_SSH       ${BLORG_KVM_SSH:-unset}"
    echo "ci/guest rig        $(yes_no test -x "$REPO/ci/guest/host/guestctl")"
    echo
    echo "So, from here:"
    echo "  blorg check                Linux tier (driver compile check, pins, server-rs)"
    if gh_ok; then
        echo "  blorg ci build|guest|remote  real MSVC build and real-kernel tests, via GitHub Actions"
    else
        echo "  (no GitHub token)          push the branch and read CI on the PR; see 'blorg ci' for how to add a token"
    fi
    if on_kvm_host || [[ -n "${BLORG_KVM_SSH:-}" ]]; then
        echo "  blorg win build|test       Windows build VM + test guest on the KVM host"
    fi
}

# ---------------------------------------------------------------- main

case "${1:-}" in
    setup)        shift; cmd_setup "$@" ;;
    check)        shift; cmd_check "$@" ;;
    driver-check) shift; cmd_driver_check "$@" ;;
    pins)         shift; cmd_pins ;;
    server-test)  shift; cmd_server_test ;;
    server-exe)   shift; cmd_server_exe "$@" ;;
    ci)           shift; cmd_ci "$@" ;;
    win)          shift; cmd_win "$@" ;;
    doctor)       shift; cmd_doctor ;;
    ""|-h|--help|help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)            die "unknown command '$1' (blorg help)" ;;
esac
