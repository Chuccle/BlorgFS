# The Linux half of the BlorgFS toolchain as one image: everything
# tools/blorg runs (the driver compile check, server-rs tests and clippy,
# the server and package builds, and the GitHub Actions commands).
# `tools/blorg container [command]` builds it on first use and runs it
# against the checkout, with podman or docker.
#
# It holds no Windows toolchain: MSVC and the WDK run only on Windows, and
# no Linux container can load a Windows kernel driver. That half is
# build.yml and the guest runtime tests, which `blorg ci` drives.

FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -q && apt-get install -y -q --no-install-recommends \
        ca-certificates curl git unzip \
        build-essential clang cmake openssl python3 \
        musl-tools gcc-mingw-w64-x86-64 \
        gh \
    && rm -rf /var/lib/apt/lists/* \
    # The checkout is bind-mounted and may belong to another uid.
    && git config --system --add safe.directory '*'

ENV RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo PATH=/opt/rust/cargo/bin:$PATH
# The toolchain rust-toolchain.toml pins; blorg container passes it in.
ARG RUST_TOOLCHAIN
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
# rustup-init straight from static.rust-lang.org, checked against its pin
# before it runs.
RUN test -n "$RUST_TOOLCHAIN" \
    && curl -fsSL -o /tmp/rustup-init https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init \
    && echo "$RUSTUP_SHA256  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
        --component clippy --target x86_64-pc-windows-gnu,x86_64-unknown-linux-musl \
    && rm -rf /tmp/rustup-init \
    && chmod -R a+rwX /opt/rust

# blorg's downloads and builds (WDK/SDK headers, flatc, flatcc) live here;
# blorg container mounts a named volume over it so they survive between
# containers.
ENV BLORG_CACHE=/var/cache/blorg
RUN mkdir -p /var/cache/blorg && chmod 1777 /var/cache/blorg

WORKDIR /src
ENTRYPOINT ["tools/blorg"]
