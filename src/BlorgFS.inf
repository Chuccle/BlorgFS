;
; BlorgFS.inf
;
; Installs the BlorgFS legacy (WDM, non-PnP) filesystem driver as a
; kernel-mode service. BlorgFS creates its own device objects in
; DriverEntry rather than through a bus-enumerated FDO, so there is no
; hardware ID to match and no [Manufacturer]/[Models] section -- this is
; a Windows 10 1903+ "primitive driver" INF, installed/uninstalled as a
; unit via the driver store (DiInstallDriver/DiUninstallDriver), e.g.:
;
;   rundll32.exe setupapi.dll,InstallHinfSection DefaultInstall.NTamd64 132 <path>\BlorgFS.inf
;
; (right-click "Install" on the INF does the same thing), not through
; Device Manager's "Add Hardware" / "Update Driver". Test-signing must
; already be enabled and the driver's cert trusted -- this INF only
; installs the service, it does not touch either of those. Primitive
; drivers require Class/ClassGuid to be filled in even without real
; hardware behind them, and may not carry a [DefaultUninstall] section --
; the platform derives uninstall as the inverse of install.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "SoftwareDevice"
ClassGuid   = {62F9C741-B25A-46CE-B54C-9BCCCE08B6F2}
Provider    = %ManufacturerName%
CatalogFile = BlorgFS.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
BlorgFS.sys = 1

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = BlorgFS.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = BlorgFS,,BlorgFS.Service

[BlorgFS.CopyFiles]
BlorgFS.sys

[BlorgFS.Service]
DisplayName    = %ServiceDescription%
ServiceType    = 1  ; SERVICE_KERNEL_DRIVER
StartType      = 3  ; SERVICE_DEMAND_START
ErrorControl   = 1  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\BlorgFS.sys
LoadOrderGroup = "File System"
AddReg         = BlorgFS.Service.AddReg

[BlorgFS.Service.AddReg]
; Seeds the one override worth setting out of the box. The value must stay
; identical to BLORGFS_DEFAULT_REMOTE_HOST in Driver.c, which is what
; ReadBlorgfsRegistryConfig falls back to when this registry value is
; absent -- then an INF install and a bare driver load reach the same
; backend, and this line only decides whether operators have a
; ready-to-edit value or have to go looking for where the override lives.
;
; They had drifted: this seeded "blorgfs.blorg.lan" while the driver
; defaulted to 10.0.50.17, so an INF install with no -RemoteHost override
; pointed at a name nothing resolves, and the comment claiming they matched
; was the reason nobody looked.
;
; TLS (TlsEnabled/TlsPin) is deliberately left unset here -- opt in
; explicitly once a cert is available to pin.
HKR,Parameters,RemoteHost,0x00000000,%DefaultRemoteHost%

[Strings]
ManufacturerName   = "BlorgFS Project"
ServiceDescription = "BlorgFS Filesystem Driver"
DiskName           = "BlorgFS Installation Disk"
DefaultRemoteHost  = "10.0.50.17"
